diff --git a/src/sim/behaviors.test.ts b/src/sim/behaviors.test.ts
new file mode 100644
--- /dev/null
+++ b/src/sim/behaviors.test.ts
@@ -0,0 +1,61 @@
+import { describe, it, expect } from 'vitest';
+import { replay } from './replay';
+import { getEntityEffects } from './history';
+import { makeActor, emit } from './test-util';
+
+describe('behaviors: contaminación, acicalado, intoxicación', () => {
+  it('el jugador pisa cerveza, se lame la pata y se emborracha', () => {
+    const a = makeActor();
+    a.t = 0;
+    const entries = [
+      emit(a, 'INIT', { spawn: { x: 3, y: 3 } }),                 // t=500
+      emit(a, 'POUR', { x: 3, y: 4, material: 'beer', ml: 100 }), // t=1000
+      emit(a, 'MOVE', { x: 3, y: 4 }),                            // t=1500
+    ];
+    const w = replay(entries);
+    expect(w.players[a.id].bloodAlcohol ?? 0).toBeGreaterThan(0);
+    const effects = getEntityEffects(w, `player:${a.id}`);
+    expect(effects.some((e) => e.effect === 'contaminated')).toBe(true);
+    expect(effects.some((e) => e.effect === 'groomed')).toBe(true);
+    expect(effects.some((e) => e.effect === 'intoxicated')).toBe(true);
+  });
+
+  it('POUR rechaza materiales inválidos y distancias', () => {
+    const a = makeActor();
+    const entries = [
+      emit(a, 'INIT', { spawn: { x: 3, y: 3 } }),
+      emit(a, 'POUR', { x: 10, y: 10, material: 'beer', ml: 100 }),
+      emit(a, 'POUR', { x: 3, y: 4, material: 'nonsense', ml: 100 }),
+    ];
+    const w = replay(entries);
+    expect(w.cells['10,10']?.liquid).toBeUndefined();
+    expect(w.cells['3,4']?.liquid).toBeUndefined();
+  });
+
+  it('PLACE con payload creature crea una entidad criatura', () => {
+    const a = makeActor();
+    const entries = [
+      emit(a, 'INIT', { spawn: { x: 3, y: 3 } }),
+      emit(a, 'PLACE', { entityId: 'cat', x: 4, y: 3, creature: { massKg: 4 } }),
+    ];
+    const w = replay(entries);
+    const cat = w.entities['cat'];
+    expect(cat.kind).toBe('creature');
+    expect(cat.creature?.massKg).toBe(4);
+    expect(cat.blocksMovement).toBe(false);
+  });
+
+  it('bloodAlcohol y residue sobreviven a múltiples MOVE', () => {
+    const a = makeActor();
+    a.t = 0;
+    const entries = [
+      emit(a, 'INIT', { spawn: { x: 3, y: 3 } }),
+      emit(a, 'POUR', { x: 3, y: 4, material: 'beer', ml: 100 }),
+      emit(a, 'MOVE', { x: 3, y: 4 }),
+      emit(a, 'MOVE', { x: 3, y: 5 }),
+      emit(a, 'MOVE', { x: 3, y: 6 }),
+    ];
+    const w = replay(entries);
+    expect(w.players[a.id].bloodAlcohol ?? 0).toBeGreaterThan(0);
+  });
+});
